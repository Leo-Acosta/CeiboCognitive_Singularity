APP_NAME=Ceibo Cognitive Singularity
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
EMBEDDINGS_PROVIDER=local
EMBEDDING_MODEL=text-embedding-3-small
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://ollama:11434
TEACHER_PROVIDER=ollama
TEACHER_BASE_URL=http://127.0.0.1:11434
TEACHER_MODEL=mistral:latest
TEACHER_TIMEOUT_SECONDS=600
DEFAULT_LLM_PROVIDER=ceibo_local
CEIBO_ENGINE_MODEL_ID=ceibo-core-local-v0
CEIBO_ENGINE_MODE=rules+rag
CEIBO_TRAINING_DATASET_PATH=training/datasets/ceibo_instructions.jsonl
CEIBO_CORE_DIRECTIVE=Ayudar y ensenar a su usuario principal, facilitando cada requerimiento con respuestas claras, utiles, accionables y adaptadas a lo que necesite.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ceibo_core
POSTGRES_USER=ceibo
POSTGRES_PASSWORD=ceibo_dev_password
DATABASE_URL=postgresql+asyncpg://ceibo:ceibo_dev_password@postgres:5432/ceibo_core

REDIS_URL=redis://redis:6379/0
QDRANT_URL=http://qdrant:6333
NATS_URL=nats://nats:4222
PERSISTENCE_ENABLED=true
EVENT_BUS_ENABLED=true
MEMORY_VECTOR_ENABLED=true
MEMORY_COLLECTION_NAME=ceibo_memories
MEMORY_EMBEDDING_DIMENSIONS=384
MEMORY_LOCAL_LIMIT=500

JWT_SECRET=change-me-in-production
JWT_ISSUER=ceibo-core
ACCESS_TOKEN_MINUTES=60
RBAC_ENFORCED=false
LOCAL_DEV_ADMIN_ENABLED=true

ENABLE_SYSTEM_CONTROL=false
ENABLE_DESKTOP_AUTOMATION=false
SANDBOX_WORKDIR=/workspace/sandbox

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8765
