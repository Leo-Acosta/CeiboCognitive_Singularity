{
  "project": "Project CeiboCore",
  "method": "qlora",
  "base_model": "mistralai/Mistral-7B-Instruct-v0.3",
  "ollama_teacher_model": "mistral:latest",
  "dataset": "training/datasets/ceibo_instructions.curated.jsonl",
  "output_dir": "models/adapters/ceibo-core-mistral-qlora-v1",
  "max_seq_length": 2048,
  "lora_rank": 16,
  "lora_alpha": 32,
  "lora_dropout": 0.05,
  "learning_rate": 0.0002,
  "epochs": 1,
  "per_device_train_batch_size": 1,
  "gradient_accumulation_steps": 4,
  "logging_steps": 1,
  "save_steps": 25,
  "max_steps": 1,
  "local_files_only": false,
  "target_modules": [
    "q_proj",
    "k_proj",
    "v_proj",
    "o_proj",
    "gate_proj",
    "up_proj",
    "down_proj"
  ],
  "notes": "Ollama mistral:latest acts as Teacher IA. QLoRA training requires a HuggingFace/Transformers base model, CUDA, torch, transformers, datasets, peft, accelerate and bitsandbytes."
}
